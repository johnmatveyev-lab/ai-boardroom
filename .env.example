# ── LLM providers ────────────────────────────────────────────────────────────
# Primary: Google Gemini (chat, file analysis, voice). Falls back to OpenRouter
# for text chat if unset or if a Gemini call fails.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional per-role model overrides (see utils/llm_router.js for defaults)
# MODEL_JARVIS=
# MODEL_CEO=
# MODEL_CTO=
# MODEL_CMO=
# MODEL_CFO=

# ── Storage ──────────────────────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=./obsidian_vault

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated list of origins allowed to call the API cross-origin, e.g.
# https://boardroom.example.com,https://app.example.com
# Leave unset to deny ALL cross-origin browser access (recommended default —
# the app's own same-origin frontend is unaffected either way).
ALLOWED_ORIGINS=

# ── Local tool bridge (routes/tools.js) ─────────────────────────────────────
# Lets Jarvis (voice mode) read/write files and, if enabled, run shell
# commands on THIS machine via /api/tools/execute. Disabled unless both of
# these are set. Treat TOOLS_API_KEY like a password — anyone who has it can
# reach the file-read/write tools, and the shell as well if enabled below.
#
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOOLS_API_KEY=

# Set to "true" to allow execute_cli_command (arbitrary shell access as the
# server process). Only do this on a machine or container you're comfortable
# handing full shell access to — this is NOT sandboxed. Keep it "false"
# (or unset) on anything shared, cloud-hosted, or internet-facing.
ENABLE_LOCAL_TOOLS=false
